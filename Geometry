////////////////////////////////////////// CIRCLE STRUCT & MEC //////////////////////////////////////////

struct circle {
    pt c;
    T r;

    circle() : c(0, 0), r(0) {
    }

    circle(pt c, T r) : c(c), r(r) {
    }

    // دائرة تمادي نقطتين (قطر)
    circle(pt a, pt b) {
        c = (a + b) / (T) 2.0;
        r = abs(a - b) / (T) 2.0;
    }

    // دائرة تمر بـ 3 نقاط غير على استقامة واحدة
    circle(pt a, pt b, pt c_pt) {
        if (sgn(cross(b - a, c_pt - a)) == 0) {
            // نقاط على استقامة واحدة
            // نأخذ أطول ضلع كقطر
            T d1 = abs(a - b), d2 = abs(b - c_pt), d3 = abs(c_pt - a);
            if (d1 >= d2 && d1 >= d3) *this = circle(a, b);
            else if (d2 >= d1 && d2 >= d3) *this = circle(b, c_pt);
            else *this = circle(c_pt, a);
        } else {
            auto res = circumCircle(a, b, c_pt);
            c = res.first;
            r = res.second;
        }
    }

    bool contains(pt p) const {
        return sgn(abs(p - c) - r) <= 0;
    }
};

circle minimum_enclosing_circle(vector<pt> p) {
    static mt19937 rng(1337);
    shuffle(p.begin(), p.end(), rng);
    int n = p.size();
    if (n == 0) return circle({0, 0}, 0);
    if (n == 1) return circle(p[0], 0);

    circle c(p[0], 0);
    for (int i = 1; i < n; i++) {
        if (!c.contains(p[i])) {
            c = circle(p[i], 0);
            for (int j = 0; j < i; j++) {
                if (!c.contains(p[j])) {
                    c = circle(p[i], p[j]);
                    for (int k = 0; k < j; k++) {
                        if (!c.contains(p[k])) {
                            c = circle(p[i], p[j], p[k]);
                        }
                    }
                }
            }
        }
    }
    return c;
}
double maximum_dist_from_polygon_to_polygon(vector<pt> &u, vector<pt> &v){ //O(n)
    int n = (int)u.size(), m = (int)v.size();
    double ans = 0;
    if (n < 3 || m < 3) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) ans = max(ans, dist2(u[i], v[j]));
        }
        return sqrt(ans);
    }
    if (u[0].x > v[0].x) swap(n, m), swap(u, v);
    int i = 0, j = 0, step = n + m + 10;
    while (j + 1 < m && v[j].x < v[j + 1].x) j++ ;
    while (step--) {
        if (cross(u[(i + 1)%n] - u[i], v[(j + 1)%m] - v[j]) >= 0) j = (j + 1) % m;
        else i = (i + 1) % n;
        ans = max(ans, dist2(u[i], v[j]));
    }
    return sqrt(ans);
}
